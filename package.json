{
  "name": "wechat-mini-game",
  "version": "1.0.0",
  "private": true,
  "description": "Taro React TypeScript WeChat mini game",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11.0 <23",
    "pnpm": ">=9.15.0 <10"
  },
  "scripts": {
    "dev:weapp": "pnpm exec taro build --type weapp --watch",
    "build:weapp": "pnpm exec taro build --type weapp",
    "dev:h5": "pnpm exec taro build --type h5 --watch",
    "build:h5": "pnpm exec taro build --type h5",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "dependencies": {
    "@tarojs/components": "4.2.0",
    "@tarojs/helper": "4.2.0",
    "@tarojs/plugin-framework-react": "4.2.0",
    "@tarojs/plugin-platform-h5": "4.2.0",
    "@tarojs/plugin-platform-weapp": "4.2.0",
    "@tarojs/react": "4.2.0",
    "@tarojs/runtime": "4.2.0",
    "@tarojs/shared": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "framer-motion": "^12.12.1",
    "pixi.js": "^8.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-react": "^7.28.5",
    "@tarojs/cli": "4.2.0",
    "@tarojs/webpack5-runner": "4.2.0",
    "@types/node": "^22.15.18",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "babel-preset-taro": "4.2.0",
    "postcss": "^8.5.3",
    "sass": "^1.89.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 5",
    "ios >= 9"
  ]
}
